# ════════════════════════════════════════
#   KONFIGURASI BOT - Isi semua value ini!
# ════════════════════════════════════════

# [WAJIB] Token bot Discord
# Dapatkan di: https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_token_here
# [WAJIB] Google Gemini API Key
# Dapatkan di: https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# [OPSIONAL] ElevenLabs untuk TTS yang lebih natural
# Dapatkan di: https://elevenlabs.io
ELEVENLABS_API_KEY=your_elevenlabs_key_here

# [OPSIONAL] Stable Diffusion (Automatic1111 WebUI)
# Jalankan lokal di: http://127.0.0.1:7860
SD_API_URL=http://127.0.0.1:7860

# [OPSIONAL] Hugging Face (alternatif image gen gratis)
HF_API_KEY=your_huggingface_key_here

# ── Info Bot (bisa kamu ubah) ────────────────
BOT_AUTHOR=Nama Kamu
BOT_VERSION=1.0.0
BOT_PURPOSE=Bot AI serba bisa untuk server Discord

# ── Konfigurasi Perilaku ─────────────────────
# ID channel untuk auto-post (pisahkan dengan koma)
AUTO_POST_CHANNELS=123456789,987654321

# Interval auto-post dalam menit (default: 60)
AUTO_POST_INTERVAL=60

# Model Gemini yang dipakai
GEMINI_MODEL=gemini-3.5-flash
